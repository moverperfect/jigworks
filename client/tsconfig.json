{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2024",
      "dom"
    ],
    "types": [
      "vite/client"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "vite.config.ts",
    "../src/shared/workspace-name.ts",
    "../src/shared/check-report.ts",
    "../src/shared/build-report.ts",
    "../src/shared/conversation.ts"
  ]
}
