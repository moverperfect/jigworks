{
  "name": "jigworks",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "generate": "node templates/pack.mjs && node scripts/pack-checker.mjs",
    "platform:dev": "wrangler dev --ip 127.0.0.1 --port 8787 --local-upstream 127.0.0.1:8787 --upstream-protocol http",
    "agent:fake": "node scripts/fake-anthropic.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.79",
    "@cloudflare/shell": "0.4.3",
    "@cloudflare/think": "0.20.2",
    "@cloudflare/worker-bundler": "0.2.6",
    "agents": "0.28.1",
    "ai": "7.0.138",
    "es-module-lexer": "3.0.3",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "semver": "7.8.5",
    "ts-rust-wasm": "link:vendor/ts-rust-wasm",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@types/semver": "7.8.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.149.0"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "node-liblzma"
    ],
    "overrides": {
      "undici@<7.30.1": "7.30.1",
      "zod@<4.6.6": "4.6.7"
    }
  }
}
