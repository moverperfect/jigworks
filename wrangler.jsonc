{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jigworks",
  "main": "src/platform/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Jack's Installation. It's served only at app.jigworks.dev, behind the
  // platform's Access application. The custom domain makes Cloudflare create
  // the DNS record and certificate.
  // Apps answer on their own domain (ADR 0012), through the same Worker.
  "routes": [
    { "pattern": "app.jigworks.dev", "custom_domain": true },
    { "pattern": "*.jigworks.app/*", "zone_name": "jigworks.app" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true },
  // The Worker runs first for every request, because apps' hostnames must
  // never be answered with the platform's pages. It serves those through
  // ASSETS on the platform's own hostname.
  "assets": {
    "directory": "client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "DEVELOPERS", "class_name": "Developer" },
      { "name": "WORKSPACES", "class_name": "Workspace" },
      // One per app, named by its label (ADR 0009).
      { "name": "APP_HOSTS", "class_name": "AppHost" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Developer", "Workspace"] },
    { "tag": "v2", "new_sqlite_classes": ["AppHost"] }
  ],
  // Checks run in Dynamic Workers (ADR 0010).
  "worker_loaders": [{ "binding": "LOADER" }],
  "vars": {
    // The platform's own Access application. While either is empty, every
    // API request is refused. scripts/set-up-installation.sh collects them.
    "ACCESS_TEAM_DOMAIN": "moverperfect.cloudflareaccess.com",
    "ACCESS_AUD": "43b91065b96e9ac3ef54698ea8a7bb1b4f07604502f80ed4dba375e610cf359e",
    // Apps live on a domain of their own, behind their own Access application
    // (ADR 0012). Both are used from ticket 08 on.
    "APPS_DOMAIN": "jigworks.app",
    "APPS_ACCESS_AUD": "50f3610a9815281e06ff9f0918fed58fa2e4f91f38444db6d36171c9dec95332",
    "PLATFORM_ORIGIN": "https://app.jigworks.dev",
    // Set only in a local .dev.vars, for wrangler dev. The gate ignores it for
    // any hostname but localhost.
    "DEV_SIGNED_IN_AS": "",
    // The Agent's model, on the Anthropic API.
    "AGENT_MODEL": "claude-opus-5-5",
    // Empty for Anthropic's own API. A local .dev.vars can point it at the
    // scripted model (scripts/fake-anthropic.mjs). Not ANTHROPIC_BASE_URL,
    // which the Anthropic provider reads itself and refuses when it's empty.
    "AGENT_BASE_URL": ""
  },
  // The Operator sets both with `wrangler secret put`. DEVELOPER_LIST is
  // comma-separated emails, and @domain entries for everyone at a domain; while
  // it's empty, nobody gets in. It's a secret so that the addresses stay out of
  // the repo. (DEVELOPERS is the Durable Object namespace above.)
  "secrets": { "required": ["ANTHROPIC_API_KEY", "DEVELOPER_LIST"] }
}
